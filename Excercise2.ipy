      "source": [
        " #program that checks given numver is prime number or not\n",
        "n=int(input())\n",
        "for i in range(2,n):\n",
        "\n",
        "  if(n%i==0):\n",
        "   print(\"not a prime\")\n",
        "   break\n",
        "else:\n",
        "  print(\"yes it is prime\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Xe-KpMG_UKs9",
