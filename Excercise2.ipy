    {
      "cell_type": "code",
      "source": [
        "#program that finds reverse of a given number\n",
        "n=int(input(\"enter any number\"))\n",
        "sum=0\n",
        "while(n!=0):\n",
        "  rem=n%10\n",
        "  sum=sum * 10 +rem\n",
        "  n=n//10\n",
        "print(sum)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
