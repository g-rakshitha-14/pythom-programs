      "source": [
        "#1 program that finds maximum among threee numbers\n",
        "a=int(input())\n",
        "b=int(input())\n",
        "c=int(input())\n",
        "if (a>b and a>c):\n",
        " print (f\"{a} is maximum\")\n",
        "elif (b>a and b>c):\n",
        " print (f\"{b} is maximum\")\n",
        "else:\n",
        " print (f\"{c} is maximum\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#check given year is leap year or not\n",
        "a=int(input(\"enter any year:\"))\n",
        "if((a%4==0 and a%100!=0) or a%100==0):\n",
        " print(\"given year is leap year \")\n",
        "else:\n",
        " print(\"givenn year is not leap year\")"
      ],
      "metadata": {
