    {
      "cell_type": "code",
      "source": [
        "#program that prints the prime numbers in given range\n",
        "a=int(input())\n",
        "b=int(input())\n",
        "for i in range(a,b+1):\n",
        " for j in range(2,i):\n",
        "  if(i%j==0):\n",
        "    break\n",
        " else:\n",
        "  print(i)"
      ],
      "metadata": {
        "colab": {
